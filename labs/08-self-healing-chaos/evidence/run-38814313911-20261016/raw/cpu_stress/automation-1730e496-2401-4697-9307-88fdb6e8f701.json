                    "Script": "\"import boto3\\n\\ndef handler(events, context):\\n    asg_name = events[\\\"asg\\\"]\\n    direction = events[\\\"direction\\\"]\\n    baseline = int(events[\\\"baseline\\\"])\\n    cap = int(events[\\\"max\\\"])\\n    client = boto3.client(\\\"autoscaling\\\")\\n    groups = client.describe_auto_scaling_groups(AutoScalingGroupNames=[asg_name])[\\\"AutoScalingGroups\\\"]\\n    if not groups:\\n        raise Exception(\\\"ASG not found: \\\" + asg_name)\\n    current = groups[0][\\\"DesiredCapacity\\\"]\\n    cap = min(cap, groups[0][\\\"MaxSize\\\"])\\n    if direction == \\\"out\\\":\\n        target = max(current, min(current + 1, cap))  # \\\"out\\\" never lowers capacity\\n    else:\\n        target = max(baseline, groups[0][\\\"MinSize\\\"]) if current > baseline else current\\n    if target == current:\\n        return {\\\"direction\\\": direction, \\\"previous\\\": str(current), \\\"desired\\\": str(target), \\\"action\\\": \\\"none\\\"}\\n    client.set_desired_capacity(AutoScalingGroupName=asg_name, DesiredCapacity=target, HonorCooldown=False)\\n    return {\\\"direction\\\": direction, \\\"previous\\\": str(current), \\\"desired\\\": str(target), \\\"action\\\": \\\"set_desired_capacity\\\"}\""

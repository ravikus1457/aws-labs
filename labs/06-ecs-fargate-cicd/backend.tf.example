# Copy to backend.tf (git-ignored) to use the remote state created by ./bootstrap.
# The bootstrap stack prints this block ready-filled: terraform output -raw backend_tf
# CI writes the same file from the TF_STATE_BUCKET / AWS_REGION repo variables.
terraform {
  backend "s3" {
    bucket       = "awslabs-lab06-tfstate-<ACCOUNT_ID>"
    key          = "lab06/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true # S3-native lock (Terraform >= 1.10); no DynamoDB table
  }
}

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# .terraform.lock.hcl is COMMITTED for lab 06 (2026-10-01: upload-artifact@v4 skips dotfiles, so the apply job's
# read-only init saw 'provider dependency changes'); hashes recorded for linux_amd64 + linux_arm64.

# Evidence runs (these can be large / account-specific). Keep the dir, ignore runs.
evidence/*/
!evidence/.gitkeep

# Local env / secrets — NEVER commit these
.env
*.pem
*.key
aws-credentials*
secrets*

# OS
.DS_Store

# Lab 06: per-machine backend config (written by bootstrap output / CI)
labs/06-ecs-fargate-cicd/backend.tf
labs/06-ecs-fargate-cicd/evidence/

# Python
__pycache__/
*.pyc

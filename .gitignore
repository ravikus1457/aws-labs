# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# .terraform.lock.hcl is COMMITTED for lab 06 (2026-10-01: upload-artifact@v4 skips dotfiles, so the apply job's
# read-only init saw 'provider dependency changes'); hashes recorded for linux_amd64 + linux_arm64.

# Evidence runs (these can be large / account-specific). Keep the dir, ignore runs.
evidence/*/
!evidence/.gitkeep

# Local env / secrets — NEVER commit these
.env
*.pem
*.key
aws-credentials*
secrets*

# OS
.DS_Store

# Lab 06: per-machine backend config (written by bootstrap output / CI)
labs/06-ecs-fargate-cicd/backend.tf
labs/06-ecs-fargate-cicd/evidence/*
# CI runs' evidence IS committed (the portfolio's proof); gitignore has no trailing comments, hence this line
!labs/06-ecs-fargate-cicd/evidence/run-*/

# Lab 07: same pattern (backend.tf is git-ignored, committed evidence lives under evidence/run-*/)
labs/07-eks-observability/backend.tf
labs/07-eks-observability/bootstrap/backend.tf
labs/07-eks-observability/evidence/*
!labs/07-eks-observability/evidence/run-*/
labs/07-eks-observability/evidence/run-*/kubeconfig
labs/07-eks-observability/image-tag.txt
labs/07-eks-observability/outputs.json

# Python
__pycache__/
*.pyc

# runner evidence from REAL runs is committed per lab (the portfolio's proof); scratch runs stay under evidence/
labs/*/evidence/*
!labs/*/evidence/run-*/

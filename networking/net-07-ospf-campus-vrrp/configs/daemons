# FRR daemons for lab N7 (shared by every router; bind-mounted to /etc/frr/daemons).
# zebra, mgmtd and staticd always run. VRRP is keepalived's job here, not FRR's vrrpd (see README).
zebra=yes
ospfd=yes
staticd=yes
bgpd=no
bfdd=no
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
pim6d=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
fabricd=no
vrrpd=no
pathd=no

vtysh_enable=yes
zebra_options="  -A 127.0.0.1 -s 90000000"
mgmtd_options="  -A 127.0.0.1"
ospfd_options="  -A 127.0.0.1"
staticd_options="-A 127.0.0.1"

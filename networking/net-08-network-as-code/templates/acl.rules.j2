# {{ r.name }} - GENERATED by netaac: ACL intent enforced on this router (iptables-restore format).
# Stateful: return traffic of an allowed flow passes. First match wins. Default: permit.
*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:NET08-ACL - [0:0]
-A FORWARD -j NET08-ACL
-A NET08-ACL -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "net08:stateful-return" -j ACCEPT
{% for rule in rules %}
-A NET08-ACL -i {{ rule.iface }} -s {{ rule.src_net }}{% if rule.dst_net.prefixlen %} -d {{ rule.dst_net }}{% endif %}{% if rule.proto != "any" %} -p {{ rule.proto }}{% endif %}{% if rule.port %} -m {{ rule.proto }} --dport {{ rule.port }}{% endif %} -m comment --comment "acl:{{ rule.name }}" -j {{ "DROP" if rule.action == "deny" else "ACCEPT" }}
{% endfor %}
COMMIT

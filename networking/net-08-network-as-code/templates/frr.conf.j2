! {{ r.name }} - GENERATED by netaac from intent/network.yaml. Do not edit on the box:
! the drift check compares the running config to this file and flags any difference.
frr defaults traditional
hostname {{ r.name }}
service integrated-vtysh-config
!
{% for pl in prefix_lists %}
{% for p in pl.prefixes %}
ip prefix-list {{ pl.name }} seq {{ loop.index * 5 }} permit {{ p }}
{% else %}
ip prefix-list {{ pl.name }} seq 5 deny any
{% endfor %}
{% endfor %}
!
interface lo
 ip address {{ r.loopback }}/32
{% if r.ospf %}
 ip ospf area 0
 ip ospf passive
{% endif %}
exit
!
{% for i in r.ifaces %}
interface {{ i.name }}
 description {{ descriptions[i.name] }}
 ip address {{ i.ip.with_prefixlen }}
{% if i.ospf %}
 ip ospf area 0
{% if i.ospf == "passive" %}
 ip ospf passive
{% else %}
 ip ospf network point-to-point
{% endif %}
{% endif %}
exit
!
{% endfor %}
{% if r.bgp %}
router bgp {{ r.asn }}
 bgp router-id {{ r.loopback }}
{% for n in r.neighbors %}
 neighbor {{ n.peer_ip }} remote-as {{ n.peer_asn }}
 neighbor {{ n.peer_ip }} description {{ n.peer }}
 neighbor {{ n.peer_ip }} timers 3 9
 neighbor {{ n.peer_ip }} timers connect 5
{% endfor %}
 !
 address-family ipv4 unicast
{% for p in r.bgp_networks %}
  network {{ p }}
{% endfor %}
{% for n in r.neighbors %}
  neighbor {{ n.peer_ip }} route-map RM-{{ n.tag }}-IN in
  neighbor {{ n.peer_ip }} route-map RM-{{ n.tag }}-OUT out
{% endfor %}
 exit-address-family
exit
!
{% endif %}
{% if r.ospf %}
router ospf
 ospf router-id {{ r.loopback }}
{% if r.ospf_redistribute_prefixes %}
 redistribute bgp route-map RM-BGP-TO-OSPF
{% endif %}
exit
!
{% endif %}
{% for rm in route_maps %}
route-map {{ rm.name }} permit 10
 match ip address prefix-list {{ rm.prefix_list }}
exit
!
{% endfor %}
end

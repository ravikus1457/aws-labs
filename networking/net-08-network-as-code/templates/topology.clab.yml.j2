# GENERATED by netaac from intent/network.yaml - containerlab topology for lab N8.
# Interface addressing, ACLs and listeners are applied after deploy by `python -m netaac post-deploy`.
name: {{ net.name }}
mgmt:
  network: {{ net.name }}-mgmt
  ipv4-subnet: {{ net.mgmt_subnet }}
topology:
  nodes:
{% for r in routers %}
    {{ r.name }}:
      kind: linux
      image: {{ net.images.router }}
      binds:
        - configs/{{ r.name }}/daemons:/etc/frr/daemons:ro
        - configs/{{ r.name }}/frr.conf:/etc/frr/frr.conf
        - configs/{{ r.name }}/vtysh.conf:/etc/frr/vtysh.conf:ro
      labels:
        net08.role: router
        net08.site: {{ r.site }}
{% endfor %}
{% for h in hosts %}
    {{ h.name }}:
      kind: linux
      image: {{ net.images.host }}
      cmd: sleep infinity
      labels:
        net08.role: host
        net08.subnet: {{ h.subnet }}
{% endfor %}
  links:
{% for a, b in links %}
    - endpoints: ["{{ a }}", "{{ b }}"]
{% endfor %}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ravikus1457/aws-labs/networking/net-08-network-as-code/intent/schema.json",
  "title": "net08 source of truth",
  "description": "Structure only. Semantic rules (overlaps, duplicates, references, ACL sanity) live in netaac/validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "lab", "ip_plan", "sites", "subnets", "routers", "bgp_sessions", "hosts", "acl"],
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}$"},
    "ipv4": {"type": "string", "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}$"},
    "prefix": {"type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([0-9]|[12][0-9]|3[0-2])$"},
    "ifname": {"type": "string", "pattern": "^eth[1-9][0-9]?$"},
    "service": {"type": "string", "pattern": "^(tcp|udp)/[0-9]{1,5}$"}
  },
  "properties": {
    "version": {"const": 1},
    "lab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mgmt_subnet", "images"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "mgmt_subnet": {"$ref": "#/$defs/prefix"},
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": ["router", "host"],
          "properties": {
            "router": {"type": "string", "pattern": "^[^:@\\s]+(:[A-Za-z0-9._-]+)(@sha256:[0-9a-f]{64})?$", "not": {"pattern": ":latest(@|$)"}},
            "host": {"type": "string", "pattern": "^[^:@\\s]+(:[A-Za-z0-9._-]+)(@sha256:[0-9a-f]{64})?$", "not": {"pattern": ":latest(@|$)"}}
          }
        }
      }
    },
    "ip_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wan_block", "loopback_block"],
      "properties": {
        "wan_block": {"$ref": "#/$defs/prefix"},
        "loopback_block": {"$ref": "#/$defs/prefix"}
      }
    },
    "sites": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asn", "role", "block"],
        "properties": {
          "asn": {"type": "integer", "minimum": 64512, "maximum": 65534},
          "role": {"enum": ["hub", "spoke"]},
          "block": {"$ref": "#/$defs/prefix"},
          "description": {"type": "string"}
        }
      }
    },
    "subnets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prefix", "kind"],
        "properties": {
          "prefix": {"$ref": "#/$defs/prefix"},
          "kind": {"enum": ["lan", "p2p"]},
          "site": {"$ref": "#/$defs/name"}
        }
      }
    },
    "routers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["site", "loopback", "interfaces"],
        "properties": {
          "site": {"$ref": "#/$defs/name"},
          "loopback": {"$ref": "#/$defs/ipv4"},
          "ospf": {
            "type": "object",
            "additionalProperties": false,
            "properties": {"redistribute_bgp": {"type": "boolean"}}
          },
          "interfaces": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"$ref": "#/$defs/ifname"},
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["subnet", "ip"],
              "properties": {
                "subnet": {"$ref": "#/$defs/name"},
                "ip": {"$ref": "#/$defs/ipv4"},
                "ospf": {"enum": ["active", "passive"]}
              }
            }
          }
        }
      }
    },
    "bgp_sessions": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {"$ref": "#/$defs/name"}
      }
    },
    "hosts": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subnet", "ip"],
        "properties": {
          "subnet": {"$ref": "#/$defs/name"},
          "ip": {"$ref": "#/$defs/ipv4"},
          "services": {"type": "array", "items": {"$ref": "#/$defs/service"}, "uniqueItems": true}
        }
      }
    },
    "acl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_action", "rules"],
      "properties": {
        "default_action": {"const": "permit"},
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "src", "dst", "proto", "action"],
            "properties": {
              "name": {"$ref": "#/$defs/name"},
              "src": {"$ref": "#/$defs/name"},
              "dst": {"$ref": "#/$defs/name"},
              "proto": {"enum": ["any", "icmp", "tcp", "udp"]},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "action": {"enum": ["permit", "deny"]}
            }
          }
        }
      }
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "proto", "expect"],
        "properties": {
          "from": {"$ref": "#/$defs/name"},
          "to": {"$ref": "#/$defs/name"},
          "proto": {"enum": ["icmp", "tcp"]},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "expect": {"enum": ["allow", "deny"]}
        }
      }
    }
  }
}

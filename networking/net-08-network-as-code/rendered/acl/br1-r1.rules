# br1-r1 - GENERATED by netaac: ACL intent enforced on this router (iptables-restore format).
# Stateful: return traffic of an allowed flow passes. First match wins. Default: permit.
*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:NET08-ACL - [0:0]
-A FORWARD -j NET08-ACL
-A NET08-ACL -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "net08:stateful-return" -j ACCEPT
-A NET08-ACL -i eth2 -s 10.20.10.0/24 -d 10.10.10.0/24 -p tcp -m tcp --dport 22 -m comment --comment "acl:br1-no-ssh-servers" -j DROP
COMMIT
